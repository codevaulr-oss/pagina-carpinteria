---
const navLinks = [
  { name: 'Inicio',    href: '/'          },
  { name: 'Nosotros',  href: '/nosotros'  },
  { name: 'Galería',   href: '/galeria'   },
  { name: 'Cotizador', href: '/cotizador' },
  { name: 'Contacto',  href: '/contacto'  },
];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="fixed w-full top-0 z-50 bg-stone-900/90 backdrop-blur-md border-b border-amber-900/30">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">

    <!-- Logo -->
    <a href="/" class="text-2xl font-extrabold tracking-wider text-amber-500 uppercase flex items-center gap-2">
      <span>🪵</span> Muebles Rústicos
    </a>

    <!-- Nav desktop -->
    <nav class="hidden md:flex space-x-1">
      {navLinks.map(link => {
        const isActive = link.href === '/'
          ? path === '/'
          : path.startsWith(link.href);
        return (
          <a
            href={link.href}
            class:list={[
              'px-4 py-2 rounded-lg font-semibold transition-colors text-sm tracking-wide',
              isActive
                ? 'text-amber-500 bg-amber-950/60'
                : 'text-stone-300 hover:text-amber-500 hover:bg-stone-800'
            ]}
            aria-current={isActive ? 'page' : undefined}
          >
            {link.name}
          </a>
        );
      })}
    </nav>

    <!-- CTA desktop -->
    <a
      href="/cotizador"
      class="hidden md:inline-flex bg-amber-700 hover:bg-amber-600 text-white font-bold px-5 py-2.5 rounded-lg transition-all text-sm shadow-md"
    >
      Cotizar
    </a>

    <!-- Hamburger mobile -->
    <button
      id="hamBtn"
      aria-label="Abrir menú"
      aria-expanded="false"
      class="md:hidden flex flex-col gap-1.5 p-2"
    >
      <span class="block w-6 h-0.5 bg-stone-200 rounded transition-all"></span>
      <span class="block w-6 h-0.5 bg-stone-200 rounded transition-all"></span>
      <span class="block w-6 h-0.5 bg-stone-200 rounded transition-all"></span>
    </button>
  </div>
</header>

<!-- Menú móvil -->
<div
  id="mobMenu"
  aria-hidden="true"
  class="hidden fixed inset-0 z-40 bg-stone-950/97 flex-col items-center justify-center gap-3"
>
  {navLinks.map(link => (
    <a
      href={link.href}
      class="text-2xl font-bold text-stone-300 hover:text-amber-500 tracking-widest uppercase px-8 py-3 rounded-xl transition-colors"
    >
      {link.name}
    </a>
  ))}
  <a
    href="/cotizador"
    class="mt-4 bg-amber-700 hover:bg-amber-600 text-white font-bold px-8 py-3 rounded-xl text-lg transition-all"
  >
    Cotizar por WhatsApp 🪵
  </a>
</div>

<script>
  const btn  = document.getElementById('hamBtn')!;
  const menu = document.getElementById('mobMenu')!;

  btn.addEventListener('click', () => {
    const open = menu.classList.toggle('hidden') === false;
    menu.classList.toggle('flex', open);
    btn.setAttribute('aria-expanded', String(open));
    menu.setAttribute('aria-hidden',  String(!open));
  });

  menu.querySelectorAll('a').forEach(a =>
    a.addEventListener('click', () => {
      menu.classList.add('hidden');
      menu.classList.remove('flex');
      btn.setAttribute('aria-expanded', 'false');
      menu.setAttribute('aria-hidden', 'true');
    })
  );
</script>