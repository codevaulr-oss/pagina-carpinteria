---
const features = [
  { icon: '🌳', title: 'Madera Natural',        desc: 'Roble, nogal, pino y cedro seleccionados a mano pieza por pieza.' },
  { icon: '📐', title: 'A la Medida',            desc: 'Fabricamos exactamente a tus dimensiones. Sin catálogos genéricos.' },
  { icon: '🎨', title: 'Acabado Artesanal',      desc: 'Ceras, lacas y barnices aplicados a mano para un resultado duradero.' },
  { icon: '🚚', title: 'Entrega e Instalación',  desc: 'Llevamos el mueble a tu hogar y lo instalamos sin costo adicional.' },
  { icon: '🔧', title: 'Garantía 12 Meses',      desc: 'Respaldo por defectos de fabricación durante todo un año.' },
  { icon: '💬', title: 'Asesoría Personal',       desc: 'Te acompañamos del diseño a la entrega. Siempre por WhatsApp.' },
];

const steps = [
  { n: '1', title: 'Contacto inicial',     desc: 'Nos escribes por WhatsApp con tu idea, espacio y presupuesto aproximado.' },
  { n: '2', title: 'Diseño y propuesta',   desc: 'Te enviamos boceto, materiales y precio final sin letra chica.' },
  { n: '3', title: 'Fabricación',          desc: 'Trabajamos tu pedido con tiempos definidos y te mantenemos informado.' },
  { n: '4', title: 'Entrega e instalación',desc: 'Coordinamos la entrega y dejamos el mueble instalado y listo.' },
];
---

<section class="py-24 bg-stone-900 border-t border-stone-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Intro -->
    <div class="mb-16">
      <span class="text-amber-500 font-bold uppercase tracking-widest text-xs">¿Quiénes somos?</span>
      <h2 class="text-3xl sm:text-5xl font-black text-stone-100 mt-2 mb-4 leading-tight">
        Artesanos de la madera<br/>
        <span class="text-amber-500">con pasión por el detalle</span>
      </h2>
      <p class="text-stone-400 max-w-xl leading-relaxed">
        Somos un taller familiar con más de una década creando muebles de madera sólida
        para hogares y negocios en todo México. Cada proyecto nace de una conversación contigo.
      </p>
    </div>

    <!-- Features grid -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-20">
      {features.map(f => (
        <div class="bg-stone-800 border border-stone-700/60 rounded-2xl p-6 hover:border-amber-600/40 transition-all">
          <div class="text-3xl mb-3">{f.icon}</div>
          <h3 class="text-lg font-bold text-stone-100 mb-2">{f.title}</h3>
          <p class="text-stone-400 text-sm leading-relaxed">{f.desc}</p>
        </div>
      ))}
    </div>

    <!-- Proceso -->
    <h3 class="text-xl font-extrabold text-amber-500 mb-8 uppercase tracking-wide">¿Cómo trabajamos?</h3>
    <div class="relative border-l-2 border-amber-800/40 pl-8 space-y-10">
      {steps.map(s => (
        <div class="relative">
          <span class="absolute -left-[2.85rem] w-9 h-9 bg-amber-700 text-white rounded-full flex items-center justify-center font-black text-sm">
            {s.n}
          </span>
          <h4 class="text-stone-100 font-bold text-base mb-1">{s.title}</h4>
          <p class="text-stone-400 text-sm leading-relaxed">{s.desc}</p>
        </div>
      ))}
    </div>

  </div>
</section>