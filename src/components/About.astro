---
const features = [
  { icon: '🌳', title: 'Madera Natural',        desc: 'Pino sólido como base. Roble, nogal y cedro disponibles según tu proyecto.' },
  { icon: '📐', title: 'A la Medida',            desc: 'Fabricamos exactamente a tus dimensiones. Sin catálogos genéricos.' },
  { icon: '🎨', title: 'Acabado Artesanal',      desc: 'Ceras, lacas y barnices aplicados a mano para un resultado duradero.' },
  { icon: '🚚', title: 'Entrega e Instalación',  desc: 'Llevamos el mueble a tu hogar y lo instalamos sin costo adicional.' },
  { icon: '🔧', title: 'Garantía 12 Meses',      desc: 'Respaldo por defectos de fabricación durante todo un año.' },
  { icon: '💬', title: 'Asesoría Personal',       desc: 'Te acompañamos del diseño a la entrega. Siempre por WhatsApp.' },
];

const steps = [
  { n: '1', title: 'Contacto inicial',      desc: 'Nos escribes por WhatsApp con tu idea, espacio y presupuesto aproximado.' },
  { n: '2', title: 'Diseño y propuesta',    desc: 'Te enviamos boceto, materiales y precio final sin letra chica.' },
  { n: '3', title: 'Fabricación',           desc: 'Trabajamos tu pedido con tiempos definidos y te mantenemos informado.' },
  { n: '4', title: 'Entrega e instalación', desc: 'Coordinamos la entrega y dejamos el mueble instalado y listo.' },
];
---

<section class="py-24 bg-stone-900 border-t border-stone-800 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Intro -->
    <div class="reveal mb-16">
      <span class="text-amber-500 font-bold uppercase tracking-widest text-xs">¿Quiénes somos?</span>
      <h2 class="text-3xl sm:text-5xl font-black text-stone-100 mt-2 mb-4 leading-tight">
        Artesanos de la madera<br/>
        <span class="text-amber-500">con pasión por el detalle</span>
      </h2>
      <p class="text-stone-400 max-w-xl leading-relaxed">
        Somos un taller familiar con más de una década creando muebles de madera sólida
        para hogares y negocios en todo México. Cada proyecto nace de una conversación contigo.
      </p>
    </div>

    <!-- Features grid -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-20">
      {features.map((f, i) => (
        <div
          class="feature-card reveal bg-stone-800 border border-stone-700/60 rounded-2xl p-6 cursor-default"
          style={`animation-delay:${i * 0.09}s`}
        >
          <div class="feature-icon text-3xl mb-3 transition-transform duration-300">{f.icon}</div>
          <h3 class="text-lg font-bold text-stone-100 mb-2">{f.title}</h3>
          <p class="text-stone-400 text-sm leading-relaxed">{f.desc}</p>
          <!-- Barra de acento inferior -->
          <div class="mt-4 h-0.5 w-0 bg-amber-600 rounded-full accent-bar transition-all duration-500"></div>
        </div>
      ))}
    </div>

    <!-- Proceso -->
    <div class="reveal">
      <h3 class="text-xl font-extrabold text-amber-500 mb-10 uppercase tracking-wide">¿Cómo trabajamos?</h3>
    </div>

    <div class="relative">
      <!-- Línea vertical -->
      <div class="timeline-line absolute left-[1.05rem] top-0 bottom-0 w-0.5 bg-amber-800/30 origin-top"></div>

      <div class="pl-12 space-y-10">
        {steps.map((s, i) => (
          <div class="step-item reveal relative" style={`animation-delay:${i * 0.12}s`}>
            <!-- Círculo numerado -->
            <div class="step-circle absolute -left-12 w-9 h-9 bg-amber-700 text-white rounded-full flex items-center justify-center font-black text-sm shadow-lg shadow-amber-900/40 transition-transform duration-300">
              {s.n}
            </div>
            <!-- Línea conector -->
            <div class="step-dot absolute -left-[0.38rem] top-1.5 w-2 h-2 rounded-full bg-amber-500 opacity-0 transition-all duration-300"></div>
            <h4 class="text-stone-100 font-bold text-base mb-1">{s.title}</h4>
            <p class="text-stone-400 text-sm leading-relaxed">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- CTA final -->
    <div class="reveal mt-20 text-center">
      <p class="text-stone-400 mb-6">¿Listo para empezar tu proyecto?</p>
      <a
        href="/cotizador"
        class="about-cta inline-flex items-center gap-3 bg-amber-700 hover:bg-amber-600 text-white font-bold px-10 py-4 rounded-2xl shadow-lg shadow-amber-900/30"
      >
        <span>Solicitar cotización gratis</span>
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>

  </div>
</section>

<style>
  /* ── Reveal ── */
  @keyframes revealUp   { from { opacity:0; transform:translateY(28px); } to { opacity:1; transform:translateY(0); } }
  @keyframes revealLeft { from { opacity:0; transform:translateX(-20px); } to { opacity:1; transform:translateX(0); } }
  .reveal { opacity:0; }
  .reveal.visible { animation: revealUp .55s cubic-bezier(.25,.8,.25,1) both; }
  .step-item.reveal.visible { animation: revealLeft .5s cubic-bezier(.25,.8,.25,1) both; }

  /* ── Feature cards ── */
  .feature-card {
    transition: transform .3s cubic-bezier(.25,.8,.25,1), border-color .3s, box-shadow .3s;
  }
  .feature-card:hover {
    transform: translateY(-6px) scale(1.01);
    border-color: rgba(217,119,6,.35);
    box-shadow: 0 16px 40px rgba(0,0,0,.4);
  }
  .feature-card:hover .feature-icon { transform: scale(1.25) rotate(-6deg); }
  .feature-card:hover .accent-bar   { width: 100%; }

  /* ── Timeline ── */
  .timeline-line { transition: transform 1.2s cubic-bezier(.25,.8,.25,1); }
  .step-circle   { transition: transform .3s, box-shadow .3s; }
  .step-item:hover .step-circle { transform: scale(1.15); box-shadow: 0 0 0 6px rgba(217,119,6,.18); }
  .step-item.visible .step-dot  { opacity:1; }

  /* ── CTA ── */
  .about-cta { transition: transform .25s cubic-bezier(.25,.8,.25,1), background .2s, box-shadow .25s; }
  .about-cta:hover { transform: translateY(-3px); box-shadow: 0 16px 40px rgba(180,90,0,.35); }
  .about-cta svg   { transition: transform .2s; }
  .about-cta:hover svg { transform: translateX(5px); }
</style>

<script>
  /* ── Scroll reveal ── */
  const obs = new IntersectionObserver(
    entries => entries.forEach(e => {
      if (e.isIntersecting) {
        (e.target as HTMLElement).classList.add('visible');
        obs.unobserve(e.target);
      }
    }),
    { threshold: 0.12 }
  );
  document.querySelectorAll('.reveal').forEach(el => obs.observe(el));

  /* ── Animate timeline line on scroll ── */
  const line = document.querySelector<HTMLElement>('.timeline-line');
  if (line) {
    line.style.transform = 'scaleY(0)';
    const lineObs = new IntersectionObserver(([e]) => {
      if (e.isIntersecting) {
        line.style.transform = 'scaleY(1)';
        lineObs.disconnect();
      }
    }, { threshold: 0.1 });
    lineObs.observe(line);
  }
</script>