---
const WA = "525500000000"; // ← cambia por tu número real

const cards = [
  { icon: '📱', label: 'WhatsApp',  value: '+52 55 0000 0000',       sub: 'Lun–Sáb  8am – 7pm' },
  { icon: '📍', label: 'Taller',    value: 'Ciudad de México',        sub: 'Consultar zona de entrega' },
  { icon: '⏰', label: 'Horario',   value: 'Lun – Sábado',            sub: '8:00 am – 7:00 pm' },
  { icon: '🚚', label: 'Entregas',  value: 'CDMX y área metropolitana', sub: 'Sin costo adicional' },
];
---

<section class="py-24 bg-stone-900 border-t border-stone-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Hero contacto -->
    <div class="text-center max-w-2xl mx-auto mb-16">
      <span class="text-amber-500 font-bold uppercase tracking-widest text-xs">Contáctanos</span>
      <h2 class="text-3xl sm:text-5xl font-black text-stone-100 mt-2 mb-4">
        ¿Listo para tu<br/><span class="text-amber-500">próximo proyecto?</span>
      </h2>
      <p class="text-stone-400 leading-relaxed">
        Escríbenos por WhatsApp. Te respondemos en menos de 2 horas con presupuesto y tiempo de entrega.
      </p>

      <a
        href={`https://wa.me/${WA}?text=${encodeURIComponent('¡Hola! Me gustaría más información sobre muebles a la medida.')}`}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-3 mt-8 bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-lg px-10 py-4 rounded-2xl transition-all shadow-lg shadow-emerald-900/30"
      >
        <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a8.65 8.65 0 00-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479s1.065 2.875 1.213 3.074c.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
        </svg>
        Escribir por WhatsApp
      </a>
    </div>

    <!-- Info cards -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {cards.map(c => (
        <div class="bg-stone-800 border border-stone-700/60 rounded-2xl p-6 text-center hover:border-amber-600/40 transition-all">
          <div class="text-3xl mb-3">{c.icon}</div>
          <div class="text-xs font-bold text-amber-500 uppercase tracking-widest mb-2">{c.label}</div>
          <div class="text-stone-100 font-bold text-sm leading-snug">{c.value}</div>
          <div class="text-stone-500 text-xs mt-1">{c.sub}</div>
        </div>
      ))}
    </div>

  </div>
</section>