---
const WA = "525511749214";

const cards = [
  { icon: '📱', label: 'WhatsApp',   value: '+52 55 1174 9214',            sub: 'Lun–Sáb  8am – 7pm' },
  { icon: '📍', label: 'Taller',     value: 'Ciudad de México',             sub: 'Consultar zona de entrega' },
  { icon: '⏰', label: 'Horario',    value: 'Lun – Sábado',                 sub: '8:00 am – 7:00 pm' },
  { icon: '🚚', label: 'Entregas',   value: 'CDMX y área metropolitana',    sub: 'Sin costo adicional' },
];
---

<section class="py-24 bg-stone-900 border-t border-stone-800 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Hero contacto -->
    <div class="text-center max-w-2xl mx-auto mb-16 reveal">
      <span class="text-amber-500 font-bold uppercase tracking-widest text-xs">Contáctanos</span>
      <h2 class="text-3xl sm:text-5xl font-black text-stone-100 mt-2 mb-4">
        ¿Listo para tu<br/><span class="text-amber-500">próximo proyecto?</span>
      </h2>
      <p class="text-stone-400 leading-relaxed">
        Escríbenos por WhatsApp. Te respondemos en menos de 2 horas con presupuesto y tiempo de entrega.
      </p>

      <a
        href={`https://wa.me/${WA}?text=${encodeURIComponent('¡Hola! Me gustaría más información sobre muebles a la medida.')}`}
        target="_blank"
        rel="noopener"
        class="contact-cta inline-flex items-center gap-3 mt-8 bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-lg px-10 py-4 rounded-2xl shadow-lg shadow-emerald-900/30"
      >
        <svg class="wa-icon w-6 h-6 fill-current" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a8.65 8.65 0 00-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479s1.065 2.875 1.213 3.074c.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
        </svg>
        Escribir por WhatsApp
      </a>
    </div>

    <!-- Info cards -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {cards.map((c, i) => (
        <div
          class="info-card reveal bg-stone-800 border border-stone-700/60 rounded-2xl p-6 text-center"
          style={`animation-delay:${i * 0.1}s`}
        >
          <div class="card-icon text-3xl mb-3 transition-transform duration-300">{c.icon}</div>
          <div class="text-xs font-bold text-amber-500 uppercase tracking-widest mb-2">{c.label}</div>
          <div class="text-stone-100 font-bold text-sm leading-snug">{c.value}</div>
          <div class="text-stone-500 text-xs mt-1">{c.sub}</div>
          <!-- Glow inferior -->
          <div class="card-glow mt-4 h-0.5 w-0 mx-auto bg-amber-600 rounded-full transition-all duration-500"></div>
        </div>
      ))}
    </div>

    <!-- Mensaje secundario -->
    <div class="reveal mt-16 text-center">
      <p class="text-stone-500 text-sm">
        También puedes enviarnos fotos de tu espacio para una cotización más precisa 📸
      </p>
    </div>

  </div>
</section>

<style>
  @keyframes revealUp { from { opacity:0; transform:translateY(28px); } to { opacity:1; transform:translateY(0); } }
  .reveal         { opacity:0; }
  .reveal.visible { animation: revealUp .55s cubic-bezier(.25,.8,.25,1) both; }

  /* ── CTA ── */
  .contact-cta { transition: transform .25s cubic-bezier(.25,.8,.25,1), background .2s, box-shadow .25s; }
  .contact-cta:hover { transform: translateY(-3px) scale(1.02); box-shadow: 0 16px 40px rgba(5,150,105,.3); }

  /* ── WA icon shake on hover ── */
  .contact-cta:hover .wa-icon { animation: waBounce .5s cubic-bezier(.25,.8,.25,1); }
  @keyframes waBounce {
    0%   { transform: rotate(0deg) scale(1); }
    25%  { transform: rotate(-12deg) scale(1.1); }
    75%  { transform: rotate(8deg) scale(1.1); }
    100% { transform: rotate(0deg) scale(1); }
  }

  /* ── Info cards ── */
  .info-card {
    transition: transform .3s cubic-bezier(.25,.8,.25,1), border-color .3s, box-shadow .3s;
  }
  .info-card:hover {
    transform: translateY(-6px);
    border-color: rgba(217,119,6,.35);
    box-shadow: 0 16px 40px rgba(0,0,0,.4);
  }
  .info-card:hover .card-icon { transform: scale(1.3) rotate(-5deg); }
  .info-card:hover .card-glow { width: 60%; }
</style>

<script>
  const obs = new IntersectionObserver(
    entries => entries.forEach(e => {
      if (e.isIntersecting) {
        (e.target as HTMLElement).classList.add('visible');
        obs.unobserve(e.target);
      }
    }),
    { threshold: 0.12 }
  );
  document.querySelectorAll('.reveal').forEach(el => obs.observe(el));
</script>