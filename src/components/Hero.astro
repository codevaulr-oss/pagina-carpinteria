---
// Hero.astro — typewriter fijo sin salto + cubo 3D madera
---

<section class="hero-section relative flex items-center min-h-screen overflow-hidden pt-20">

  <!-- Fondo -->
  <div class="hero-bg absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="grain-h absolute inset-0"></div>
    <div class="blob-1 absolute"></div>
    <div class="blob-2 absolute"></div>
    <div class="blob-3 absolute"></div>
    <svg class="wood-lines absolute inset-0 w-full h-full opacity-[0.04]" preserveAspectRatio="none">
      {Array.from({length: 18}).map((_, i) => (
        <line x1="0" y1={`${5 + i * 5.5}%`} x2="100%" y2={`${5.8 + i * 5.5}%`} stroke="#d97706" stroke-width="1"/>
      ))}
    </svg>
    <canvas id="heroCanvas" class="absolute inset-0 w-full h-full opacity-20"></canvas>
  </div>

  <div class="hero-content max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 grid md:grid-cols-2 gap-12 items-center w-full py-20">

    <!-- ── Texto ── -->
    <div class="hero-left">
      <span class="badge hero-badge inline-block py-1 px-3 rounded-full bg-amber-950 border border-amber-800/50 text-amber-400 text-xs font-bold uppercase tracking-widest mb-5">
        <span class="dot inline-block w-1.5 h-1.5 bg-amber-400 rounded-full mr-1.5 align-middle"></span>
        Trabajo Artesanal 100% Madera
      </span>

      <!-- H1 estático — nunca cambia de tamaño -->
      <h1 class="hero-h1 text-4xl sm:text-6xl font-black text-stone-100 tracking-tight leading-none mb-2">
        Diseños Rústicos &<br/>Muebles a la
      </h1>

      <!-- Línea typewriter separada para no causar reflow -->
      <div class="tw-line hero-tw mb-6">
        <span id="tw-text" class="text-amber-500 italic text-4xl sm:text-6xl font-black tracking-tight"></span><span id="tw-cursor" aria-hidden="true"></span>
      </div>

      <p class="hero-p text-lg text-stone-300 mb-8 max-w-xl leading-relaxed">
        Comedores, cocinas integrales, recámaras y proyectos de carpintería personalizados con acabados profesionales.
      </p>

      <div class="hero-btns flex flex-col sm:flex-row gap-4">
        <a href="/cotizador" class="btn-cta bg-amber-600 hover:bg-amber-500 text-white font-bold px-8 py-4 rounded-xl text-center shadow-lg shadow-amber-900/30">
          Solicitar Cotización
        </a>
        <a href="/galeria" class="btn-secondary bg-stone-800 hover:bg-stone-700 text-stone-200 font-semibold px-8 py-4 rounded-xl border border-stone-700 text-center">
          Ver Trabajos →
        </a>
      </div>

      <div class="stats-row flex flex-wrap gap-8 mt-12 pt-8 border-t border-stone-800">
        <div><span class="stat-n block text-3xl font-black text-amber-500" data-target="10"  data-suffix="+">0+</span><span class="block text-xs text-stone-400 mt-1">Años de experiencia</span></div>
        <div><span class="stat-n block text-3xl font-black text-amber-500" data-target="500" data-suffix="+">0+</span><span class="block text-xs text-stone-400 mt-1">Proyectos entregados</span></div>
        <div><span class="stat-n block text-3xl font-black text-amber-500" data-target="100" data-suffix="%">0%</span><span class="block text-xs text-stone-400 mt-1">Garantía en acabados</span></div>
      </div>
    </div>

    <!-- ══ CUBO 3D MADERA ══ -->
    <div class="deco-panel hidden md:flex flex-col items-center justify-center gap-8">

      <!-- Cubo -->
      <div class="cube-scene">
        <div class="cube-wrap">
          <div id="woodCube" class="cube">
            <!-- Frente -->
            <div class="face face-front">
              <span class="face-icon">🪑</span>
              <span class="face-label">Comedores</span>
            </div>
            <!-- Detrás -->
            <div class="face face-back">
              <span class="face-icon">🚪</span>
              <span class="face-label">Closets</span>
            </div>
            <!-- Derecha -->
            <div class="face face-right">
              <span class="face-icon">🍳</span>
              <span class="face-label">Cocinas</span>
            </div>
            <!-- Izquierda -->
            <div class="face face-left">
              <span class="face-icon">🛏️</span>
              <span class="face-label">Recámaras</span>
            </div>
            <!-- Arriba -->
            <div class="face face-top">
              <span class="face-icon">📐</span>
              <span class="face-label">A la medida</span>
            </div>
            <!-- Abajo -->
            <div class="face face-bottom">
              <span class="face-icon">🪵</span>
              <span class="face-label">Pino sólido</span>
            </div>
          </div>
        </div>
        <!-- Sombra suelo del cubo -->
        <div class="cube-shadow"></div>
      </div>

      <!-- Tags flotantes debajo del cubo -->
      <div class="tags-row flex flex-wrap justify-center gap-3">
        {['Entrega e instalación', 'Garantía 12 meses', 'CDMX y área metro'].map((t, i) => (
          <span class="tag-chip" style={`animation-delay:${i * 0.15 + 0.8}s`}>✓ {t}</span>
        ))}
      </div>

    </div>

  </div>

  <!-- Scroll indicator -->
  <div class="scroll-hint absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-stone-500">
    <span class="text-xs font-semibold tracking-widest uppercase">Scroll</span>
    <div class="w-5 h-8 rounded-full border-2 border-stone-600 flex items-start justify-center pt-1.5">
      <div class="scroll-dot w-1 h-2 bg-amber-500 rounded-full"></div>
    </div>
  </div>
</section>

<style>
  /* ── Fondo ── */
  .hero-section { background: #0f0e0b; }
  .grain-h {
    background-image:
      repeating-linear-gradient(95deg, transparent, transparent 9px, rgba(180,130,40,.04) 9px, rgba(180,130,40,.04) 10px),
      repeating-linear-gradient(180deg, transparent, transparent 40px, rgba(100,60,10,.06) 40px, rgba(100,60,10,.06) 41px);
  }
  .blob-1 { width:600px;height:600px;border-radius:50%;background:radial-gradient(circle,rgba(120,60,10,.18) 0%,transparent 70%);top:-100px;right:-100px;animation:blobDrift 12s ease-in-out infinite; }
  .blob-2 { width:400px;height:400px;border-radius:50%;background:radial-gradient(circle,rgba(180,100,20,.1) 0%,transparent 70%);bottom:0;left:-80px;animation:blobDrift 16s ease-in-out 2s infinite reverse; }
  .blob-3 { width:300px;height:300px;border-radius:50%;background:radial-gradient(circle,rgba(80,40,10,.12) 0%,transparent 70%);top:50%;left:40%;animation:blobDrift 20s ease-in-out 4s infinite; }
  @keyframes blobDrift { 0%,100%{transform:translate(0,0) scale(1)} 33%{transform:translate(20px,-30px) scale(1.05)} 66%{transform:translate(-15px,20px) scale(.95)} }

  /* ── Dot badge ── */
  .dot { animation:pulse 2s infinite; }
  @keyframes pulse { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:.4;transform:scale(.7)} }

  /* ═══════════════════════════════
     TYPEWRITER — SIN REFLOW
  ═══════════════════════════════ */
  .tw-line {
    min-height: 1.25em;          /* reserva el espacio siempre */
    display: flex;
    align-items: baseline;
    line-height: 1;
  }
  #tw-text {
    display: inline;
    white-space: nowrap;
  }
  #tw-cursor {
    display: inline-block;
    width: 4px;
    height: .82em;
    background: #f59e0b;
    margin-left: 3px;
    border-radius: 2px;
    vertical-align: baseline;
    position: relative;
    top: .06em;
    animation: cursorBlink 1.1s cubic-bezier(.4,0,.6,1) infinite;
  }
  @keyframes cursorBlink {
    0%,45%  { opacity: 1; }
    55%,100%{ opacity: 0; }
  }

  /* ═══════════════════════════════
     CUBO 3D
  ═══════════════════════════════ */
  .cube-scene {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
  }

  .cube-wrap {
    perspective: 900px;
    perspective-origin: 50% 40%;
    width: 220px;
    height: 220px;
    animation: floatY 5s ease-in-out infinite;
  }

  .cube {
    width: 220px;
    height: 220px;
    position: relative;
    transform-style: preserve-3d;
    animation: rotateCube 14s cubic-bezier(.4,0,.6,1) infinite;
  }
  @keyframes rotateCube {
    0%   { transform: rotateX(-18deg) rotateY(0deg); }
    100% { transform: rotateX(-18deg) rotateY(360deg); }
  }

  .face {
    position: absolute;
    width: 220px;
    height: 220px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    border-radius: 12px;
    border: 1.5px solid rgba(217,119,6,.25);
    backface-visibility: visible;
  }
  .face-icon  { font-size: 3.2rem; line-height: 1; filter: drop-shadow(0 4px 8px rgba(0,0,0,.5)); }
  .face-label { font-size: .78rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: #fde68a; text-shadow: 0 2px 6px rgba(0,0,0,.6); }

  /* Caras con gradiente madera */
  .face-front  {
    background: linear-gradient(135deg, #7c3a0e 0%, #5c2a08 50%, #3d1c05 100%);
    transform: translateZ(110px);
    box-shadow: inset 0 0 40px rgba(255,180,50,.06), 0 0 30px rgba(0,0,0,.4);
  }
  .face-back   {
    background: linear-gradient(135deg, #6b3209 0%, #4a2006 100%);
    transform: rotateY(180deg) translateZ(110px);
  }
  .face-right  {
    background: linear-gradient(135deg, #5c2a08 0%, #3d1c05 100%);
    transform: rotateY(90deg) translateZ(110px);
    box-shadow: inset -8px 0 20px rgba(0,0,0,.3);
  }
  .face-left   {
    background: linear-gradient(135deg, #8c4210 0%, #62300a 100%);
    transform: rotateY(-90deg) translateZ(110px);
    box-shadow: inset 8px 0 20px rgba(255,180,50,.06);
  }
  .face-top    {
    background: linear-gradient(135deg, #c8702a 0%, #a05020 50%, #7c3a10 100%);
    transform: rotateX(90deg) translateZ(110px);
    box-shadow: 0 -2px 20px rgba(255,180,50,.15);
  }
  .face-bottom {
    background: linear-gradient(135deg, #2d1504 0%, #1a0c02 100%);
    transform: rotateX(-90deg) translateZ(110px);
  }

  /* Vetas de madera en cada cara (líneas CSS) */
  .face::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 11px;
    background:
      repeating-linear-gradient(
        2deg,
        transparent,
        transparent 18px,
        rgba(255,200,80,.04) 18px,
        rgba(255,200,80,.04) 19px
      );
  }
  /* Brillo lateral cara top */
  .face-top::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 11px;
    background: radial-gradient(ellipse at 35% 30%, rgba(255,220,100,.18) 0%, transparent 70%);
  }

  /* Sombra suelo */
  .cube-shadow {
    width: 200px;
    height: 24px;
    background: radial-gradient(ellipse, rgba(0,0,0,.55) 0%, transparent 80%);
    margin-top: 6px;
    border-radius: 50%;
    animation: shadowPulse 5s ease-in-out infinite;
  }
  @keyframes shadowPulse { 0%,100%{transform:scaleX(1);opacity:.7} 50%{transform:scaleX(.85);opacity:.4} }
  @keyframes floatY      { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-12px)} }

  /* ── Tags chips ── */
  .tag-chip {
    background: rgba(120,53,15,.3);
    border: 1px solid rgba(217,119,6,.25);
    color: #fde68a;
    font-size: .7rem;
    font-weight: 700;
    padding: .35rem .75rem;
    border-radius: 999px;
    letter-spacing: .03em;
    opacity: 0;
    animation: chipIn .5s cubic-bezier(.25,.8,.25,1) both;
  }
  @keyframes chipIn { from{opacity:0;transform:translateY(10px)} to{opacity:1;transform:translateY(0)} }

  /* ── Entradas ── */
  .hero-badge  { opacity:0; animation:slideDown .5s cubic-bezier(.25,.8,.25,1) .1s  forwards; }
  .hero-h1     { opacity:0; animation:fadeUp    .7s cubic-bezier(.25,.8,.25,1) .25s forwards; }
  .hero-tw     { opacity:0; animation:fadeUp    .7s cubic-bezier(.25,.8,.25,1) .3s  forwards; }
  .hero-p      { opacity:0; animation:fadeUp    .7s cubic-bezier(.25,.8,.25,1) .4s  forwards; }
  .hero-btns   { opacity:0; animation:fadeUp    .7s cubic-bezier(.25,.8,.25,1) .55s forwards; }
  .stats-row   { opacity:0; animation:fadeUp    .7s cubic-bezier(.25,.8,.25,1) .7s  forwards; }
  .deco-panel  { opacity:0; animation:fadeLeft  .9s cubic-bezier(.25,.8,.25,1) .45s forwards; }
  .scroll-hint { opacity:0; animation:fadeUp    1s  cubic-bezier(.25,.8,.25,1) 1.2s forwards; }

  @keyframes fadeUp    { from{opacity:0;transform:translateY(32px)}  to{opacity:1;transform:translateY(0)} }
  @keyframes fadeLeft  { from{opacity:0;transform:translateX(40px)}  to{opacity:1;transform:translateX(0)} }
  @keyframes slideDown { from{opacity:0;transform:translateY(-16px)} to{opacity:1;transform:translateY(0)} }

  /* ── Scroll dot ── */
  .scroll-dot { animation:scrollBounce 1.8s ease-in-out infinite; }
  @keyframes scrollBounce { 0%,100%{transform:translateY(0);opacity:1} 80%{transform:translateY(14px);opacity:.2} }

  /* ── Botones ── */
  .btn-cta,.btn-secondary {
    display:block;
    transform:translateY(0);
    transition:transform .2s cubic-bezier(.25,.8,.25,1), box-shadow .2s, background .2s;
  }
  .btn-cta:hover     { transform:translateY(-3px); box-shadow:0 12px 30px rgba(180,90,0,.35); }
  .btn-secondary:hover { transform:translateY(-3px); }
</style>

<script>
  /* ── Canvas partículas ── */
  const canvas = document.getElementById('heroCanvas') as HTMLCanvasElement;
  if (canvas) {
    const ctx = canvas.getContext('2d')!;
    const resize = () => { canvas.width = canvas.offsetWidth; canvas.height = canvas.offsetHeight; };
    resize(); window.addEventListener('resize', resize);
    const pts = Array.from({length: 22}, () => ({
      x: Math.random() * canvas.width,
      y: Math.random() * canvas.height,
      r: Math.random() * 1.8 + .4,
      vx: (Math.random() - .5) * .3,
      vy: -(Math.random() * .3 + .1),
      a: Math.random() * Math.PI * 2,
    }));
    const tick = () => {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      pts.forEach(p => {
        p.x += p.vx; p.y += p.vy; p.a += .006;
        if (p.y < -10) { p.y = canvas.height + 10; p.x = Math.random() * canvas.width; }
        ctx.beginPath(); ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(217,119,6,${.15 + .18 * Math.sin(p.a)})`; ctx.fill();
      });
      requestAnimationFrame(tick);
    };
    tick();
  }

  /* ── Contadores ── */
  const countUp = (el: HTMLElement, target: number, suffix: string, dur = 1400) => {
    const s = performance.now();
    const step = (now: number) => {
      const t = Math.min((now - s) / dur, 1), ease = 1 - Math.pow(1 - t, 3);
      el.textContent = Math.floor(ease * target) + suffix;
      if (t < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  };
  const sObs = new IntersectionObserver(entries => entries.forEach(e => {
    if (e.isIntersecting) {
      const el = e.target as HTMLElement;
      countUp(el, parseInt(el.dataset.target!), el.dataset.suffix ?? '');
      sObs.unobserve(el);
    }
  }), { threshold: .5 });
  document.querySelectorAll<HTMLElement>('.stat-n[data-target]').forEach(el => sObs.observe(el));

  /* ══════════════════════════════
     TYPEWRITER — suave, sin reflow
  ══════════════════════════════ */
  const words = ['Medida', 'Detalle', 'Estilo', 'Hogar', 'Proyecto'];
  const twText   = document.getElementById('tw-text')!;
  const twCursor = document.getElementById('tw-cursor')!;

  if (twText) {
    let wi = 0, ci = 0, deleting = false, waiting = false;

    const tick = () => {
      if (waiting) return;
      const word = words[wi];

      if (!deleting) {
        if (ci < word.length) {
          ci++;
          twText.textContent = word.slice(0, ci);
          setTimeout(tick, 90 + Math.random() * 45);   // escritura natural
        } else {
          // pausa larga al terminar → el usuario puede leer la palabra
          waiting = true;
          setTimeout(() => { waiting = false; deleting = true; tick(); }, 2400);
        }
      } else {
        if (ci > 0) {
          ci--;
          twText.textContent = word.slice(0, ci);
          setTimeout(tick, 42 + Math.random() * 18);   // borrado más rápido
        } else {
          deleting = false;
          wi = (wi + 1) % words.length;
          waiting = true;
          setTimeout(() => { waiting = false; tick(); }, 280);  // pausa entre palabras
        }
      }
    };

    // Mostrar primera palabra completa al cargar, luego arrancar el ciclo
    twText.textContent = words[0];
    ci = words[0].length;
    setTimeout(() => { waiting = false; deleting = true; tick(); }, 2600);
  }
</script>