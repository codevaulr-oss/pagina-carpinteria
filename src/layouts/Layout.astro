---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { 
  title, 
  description = "Carpintería artesanal y muebles rústicos a la medida. Diseños exclusivos en madera." 
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800&display=swap" rel="stylesheet">
  </head>
  <body class="bg-stone-900 text-stone-100 font-['Montserrat',sans-serif] antialiased">
    <slot />

    <!-- Footer global -->
    <footer class="py-8 bg-stone-950 border-t border-stone-800 text-center text-stone-500 text-sm">
      <div class="max-w-7xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-3">
        <p>© {new Date().getFullYear()} Muebles Rústicos. Todos los derechos reservados.</p>
        <nav class="flex gap-6">
          <a href="/galeria"   class="hover:text-amber-500 transition-colors font-semibold">Galería</a>
          <a href="/nosotros"  class="hover:text-amber-500 transition-colors font-semibold">Nosotros</a>
          <a href="/contacto"  class="hover:text-amber-500 transition-colors font-semibold">Contacto</a>
        </nav>
      </div>
    </footer>

    <!-- WhatsApp flotante -->
    <a
      href="https://wa.me/525500000000"
      target="_blank"
      rel="noopener"
      aria-label="Abrir WhatsApp"
      class="fixed bottom-6 right-6 z-50 w-14 h-14 bg-emerald-500 hover:bg-emerald-400 rounded-full flex items-center justify-center shadow-xl shadow-emerald-900/40 transition-all hover:scale-110"
    >
      <svg class="w-7 h-7 fill-white" viewBox="0 0 24 24">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a8.65 8.65 0 00-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479s1.065 2.875 1.213 3.074c.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
      </svg>
    </a>
  </body>
</html>