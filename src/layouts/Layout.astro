---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Carpintería artesanal y muebles rústicos a la medida. Diseños exclusivos en madera."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800&display=swap" rel="stylesheet">
  </head>
  <body class="bg-stone-900 text-stone-100 font-['Montserrat',sans-serif] antialiased">
    <slot />

    <!-- Footer global -->
    <footer class="py-10 bg-stone-950 border-t border-stone-800 text-center text-stone-500 text-sm">
      <div class="max-w-7xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-4">
        <a href="/" class="text-xl font-extrabold tracking-wider text-amber-500 uppercase flex items-center gap-2">
          <span>🪵</span> Muebles Rústicos
        </a>
        <nav class="flex gap-6">
          <a href="/galeria"   class="footer-link hover:text-amber-500 transition-colors font-semibold">Galería</a>
          <a href="/catalogo"  class="footer-link hover:text-amber-500 transition-colors font-semibold">Catálogo</a>
          <a href="/nosotros"  class="footer-link hover:text-amber-500 transition-colors font-semibold">Nosotros</a>
          <a href="/contacto"  class="footer-link hover:text-amber-500 transition-colors font-semibold">Contacto</a>
        </nav>
        <p class="text-xs text-stone-600">© {new Date().getFullYear()} Todos los derechos reservados.</p>
      </div>
    </footer>

    <!-- WhatsApp flotante con pulso -->
    <a
      href="https://wa.me/525511749214"
      target="_blank"
      rel="noopener"
      aria-label="Abrir WhatsApp"
      id="waFloat"
      class="fixed bottom-6 right-6 z-50 w-14 h-14 bg-emerald-500 hover:bg-emerald-400 rounded-full flex items-center justify-center shadow-xl shadow-emerald-900/40 transition-all hover:scale-110"
    >
      <!-- Anillo pulsante -->
      <span class="wa-ring absolute inset-0 rounded-full bg-emerald-400"></span>
      <svg class="w-7 h-7 fill-white relative z-10" viewBox="0 0 24 24">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a8.65 8.65 0 00-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479s1.065 2.875 1.213 3.074c.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
      </svg>
    </a>

    <!-- Botón "ir arriba" -->
    <button
      id="backTop"
      aria-label="Ir arriba"
      class="fixed bottom-24 right-6 z-50 w-10 h-10 bg-stone-700/80 hover:bg-amber-700 rounded-full flex items-center justify-center transition-all opacity-0 translate-y-4 pointer-events-none shadow-lg"
    >
      <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7"/>
      </svg>
    </button>

  </body>
</html>

<style is:global>
  /* ── WhatsApp pulse ring ── */
  .wa-ring {
    animation: waPulse 2.4s cubic-bezier(0,0,.2,1) infinite;
  }
  @keyframes waPulse {
    0%   { transform:scale(1); opacity:.7; }
    70%  { transform:scale(1.55); opacity:0; }
    100% { transform:scale(1.55); opacity:0; }
  }

  /* ── Footer links ── */
  .footer-link { position:relative; }
  .footer-link::after {
    content:'';
    position:absolute; bottom:-2px; left:0;
    width:0; height:1.5px;
    background:#f59e0b;
    transition: width .3s;
    border-radius:2px;
  }
  .footer-link:hover::after { width:100%; }

  /* ── Back to top ── */
  #backTop.show {
    opacity:1;
    transform: translateY(0);
    pointer-events:auto;
  }
  #backTop { transition: opacity .3s, transform .3s, background .2s; }
</style>

<script>
  /* ── Back to top visibility ── */
  const btn = document.getElementById('backTop');
  const onScroll = () => {
    if (window.scrollY > 400) btn?.classList.add('show');
    else                       btn?.classList.remove('show');
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  btn?.addEventListener('click', () => window.scrollTo({ top:0, behavior:'smooth' }));
</script>